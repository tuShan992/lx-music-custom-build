diff --git a/src/renderer/core/userApiSourceCache.ts b/src/renderer/core/userApiSourceCache.ts
new file mode 100644
index 0000000..7136d3e
--- /dev/null
+++ b/src/renderer/core/userApiSourceCache.ts
@@ -0,0 +1,26 @@
+// 会话级缓存：最近一次音源测速结果 + 每首歌成功播放过的自定义源
+// 供播放出错自动换源时挑选“最可能可用”的源，减少逐源重载的等待。
+
+let probeRanking: LX.UserApi.UserApiProbeResult[] = []
+const songSourceCache = new Map<string, string>()
+
+export const setProbeRanking = (results: LX.UserApi.UserApiProbeResult[]) => {
+  probeRanking = Array.isArray(results) ? results : []
+}
+export const getProbeRanking = (): LX.UserApi.UserApiProbeResult[] => probeRanking
+
+export const setSongSource = (songId: string, apiId: string) => {
+  if (songId && apiId) songSourceCache.set(songId, apiId)
+}
+export const getSongSource = (songId?: string): string | undefined => songId ? songSourceCache.get(songId) : undefined
+
+// 记录“这首歌是否已经并行预探过”，同一首歌的后续重试不再重复开窗，避免卡顿放大
+let parallelTriedSongId = ''
+let parallelTriedAt = 0
+export const markParallelTried = (songId?: string) => {
+  if (!songId) return
+  parallelTriedSongId = songId
+  parallelTriedAt = Date.now()
+}
+export const wasParallelTried = (songId?: string, withinMs = 60000): boolean =>
+  !!songId && songId === parallelTriedSongId && Date.now() - parallelTriedAt < withinMs
