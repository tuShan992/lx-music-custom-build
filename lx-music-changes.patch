diff --git a/src/renderer/composables/useLocateCurrentPlay.ts b/src/renderer/composables/useLocateCurrentPlay.ts
new file mode 100644
index 0000000..0d5aa7d
--- /dev/null
+++ b/src/renderer/composables/useLocateCurrentPlay.ts
@@ -0,0 +1,66 @@
+import { ref, computed } from '@common/utils/vueTools'
+import { playMusicInfo } from '@renderer/store/player/state'
+
+export interface LocateCurrentPlayListRef {
+  scrollToIndex: (index: number, offset?: number, animate?: boolean, onScrollEnd?: () => void) => void
+}
+
+export interface UseLocateCurrentPlayOptions<T extends { id: string }> {
+  /** 额外启用条件（如歌单、排行榜需「列表点击行为」开关开启） */
+  enabled?: () => boolean
+  /** 自定义当前播放歌曲在列表中的索引计算方式 */
+  resolveIndex?: (musicInfo: { id: string }, list: T[]) => number
+}
+
+/**
+ * 定位当前播放歌曲：计算索引、滚动定位，并在定位后短暂高亮该行。
+ *
+ * @param listRef 列表组件引用（需暴露 scrollToIndex）
+ * @param getList 返回当前列表数据
+ * @param options 可选配置
+ */
+export default function useLocateCurrentPlay<T extends { id: string }>(
+  listRef: { value: LocateCurrentPlayListRef | null | undefined },
+  getList: () => T[],
+  options: UseLocateCurrentPlayOptions<T> = {},
+) {
+  const currentPlayIndex = computed(() => {
+    const musicInfo = playMusicInfo.musicInfo
+    if (!musicInfo) return -1
+    if (options.resolveIndex) return options.resolveIndex(musicInfo, getList())
+    return getList().findIndex(item => item.id === musicInfo.id)
+  })
+
+  const canLocateCurrent = computed(() => {
+    if (options.enabled && !options.enabled()) return false
+    return getList().length > 0 && currentPlayIndex.value > -1
+  })
+
+  // 定位后短暂高亮被定位的歌曲行
+  const highlightIndex = ref(-1)
+  let highlightTimer: ReturnType<typeof setTimeout> | null = null
+  const flashHighlight = (index: number) => {
+    highlightIndex.value = -1
+    if (highlightTimer) {
+      clearTimeout(highlightTimer)
+      highlightTimer = null
+    }
+    window.requestAnimationFrame(() => {
+      highlightIndex.value = index
+      highlightTimer = setTimeout(() => {
+        highlightIndex.value = -1
+        highlightTimer = null
+      }, 2600)
+    })
+  }
+
+  const handleLocateCurrentPlay = () => {
+    const index = currentPlayIndex.value
+    const list = getList()
+    if (index < 0 || index >= list.length) return
+    listRef.value?.scrollToIndex(index, -150, true)
+    flashHighlight(index)
+  }
+
+  return { highlightIndex, canLocateCurrent, handleLocateCurrentPlay }
+}
