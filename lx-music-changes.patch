new file mode 100644
index 0000000..988b500
--- /dev/null
+++ b/src/renderer/views/Setting/components/UserApiOneClickImportModal.vue
@@ -0,0 +1,341 @@
+<template>
+  <material-modal :show="show" teleport="#view" @close="handleClose">
+    <main :class="$style.main">
+      <h2>{{ $t('user_api_one_click__title') }}</h2>
+      <div :class="$style.options">
+        <base-checkbox
+          id="user_api_one_click_only_available"
+          v-model="onlyAvailable"
+          :class="$style.option"
+          :label="$t('user_api_one_click__only_available')"
+          @change="handleOnlyAvailableChange"
+        />
+        <base-checkbox
+          id="user_api_one_click_use_proxy"
+          v-model="useProxy"
+          :class="$style.option"
+          :label="$t('user_api_one_click__use_proxy')"
+        />
+      </div>
+      <p :class="$style.tip">{{ $t('user_api_one_click__tip', { time: updatedAt || '-' }) }}</p>
+      <div :class="$style.content">
+        <div v-if="loading" :class="$style.empty">{{ $t('user_api_one_click__loading') }}</div>
+        <div v-else-if="loadError" :class="$style.empty">{{ loadError }}</div>
+        <div v-else-if="!list.length" :class="$style.empty">{{ $t('user_api__noitem') }}</div>
+        <ul v-else :class="$style.list">
+          <li v-for="item in list" :key="item.key" :class="$style.item">
+            <base-checkbox
+              :id="`user_api_one_click_${item.key}`"
+              v-model="selected"
+              :value="item.key"
+              :class="$style.itemCheckbox"
+              :label="item.key"
+            />
+            <span :class="[$style.status, $style[item.cls]]">{{ item.status }}</span>
+          </li>
+        </ul>
+      </div>
+      <div :class="$style.footer">
+        <base-btn :class="$style.btn" @click="handleClose">{{ $t('btn_close') }}</base-btn>
+        <base-btn :class="$style.btn" :disabled="disabled || loading || !!loadError || !selected.length" @click="handleImport">{{ btnText }}</base-btn>
+      </div>
+    </main>
+  </material-modal>
+</template>
+
+<script>
+import { dialog } from '@renderer/plugins/Dialog'
+import { httpFetch } from '@renderer/utils/request'
+import { importUserApi, probeUserApis, removeUserApi, warmProbeWindows } from '@renderer/utils/ipc'
+import { userApi } from '@renderer/store'
+import { appSetting } from '@renderer/store/setting'
+import { setUserApi } from '@renderer/core/apiSource'
+import { setProbeRanking } from '@renderer/core/userApiSourceCache'
+
+const RAW_BASE = 'https://raw.githubusercontent.com/pdone/lx-music-source'
+const PROXY_BASE = 'https://ghproxy.net/raw.githubusercontent.com/pdone/lx-music-source'
+const HEALTH_PATH = '/health-status/health-state.json'
+const SOURCE_PATH = '/main'
+
+const statusClass = (status) => {
+  switch (status) {
+    case '可用': return 'available'
+    case '异常': return 'warn'
+    default: return 'invalid'
+  }
+}
+
+export default {
+  props: {
+    show: {
+      type: Boolean,
+      default: false,
+    },
+  },
+  emits: ['update:show', 'import-start', 'import-done'],
+  data() {
+    return {
+      onlyAvailable: true,
+      useProxy: false,
+      list: [],
+      selected: [],
+      updatedAt: '',
+      loading: false,
+      loadError: '',
+      disabled: false,
+      btnText: '',
+    }
+  },
+  watch: {
+    show(n) {
+      if (n) void this.init()
+    },
+  },
+  methods: {
+    handleClose() {
+      this.$emit('update:show', false)
+    },
+    fetchText(url) {
+      return httpFetch(url, { timeout: 20_000 }).promise.then(resp => resp.body)
+    },
+    async fetchHealth() {
+      let lastErr
+      for (const base of [RAW_BASE, PROXY_BASE]) {
+        try {
+          const body = await this.fetchText(base + HEALTH_PATH)
+          return typeof body === 'string' ? JSON.parse(body) : body
+        } catch (err) {
+          lastErr = err
+        }
+      }
+      throw lastErr
+    },
+    async init() {
+      this.loading = true
+      this.loadError = ''
+      this.list = []
+      this.selected = []
+      this.updatedAt = ''
+      this.onlyAvailable = true
+      this.useProxy = false
+      this.disabled = false
+      this.btnText = this.$t('user_api_one_click__import')
+      try {
+        const data = await this.fetchHealth()
+        this.list = Object.entries(data.sources || {}).map(([key, status]) => ({ key, status, cls: statusClass(status) }))
+        this.updatedAt = data.updated_at || ''
+        this.applyDefaultSelect()
+      } catch (err) {
+        this.loadError = this.$t('user_api_one_click__load_failed', { message: err.message })
+      } finally {
+        this.loading = false
+      }
+    },
+    applyDefaultSelect(onlyAvailable = this.onlyAvailable) {
+      this.selected = this.list
+        .filter(item => !onlyAvailable || item.status === '可用')
+        .map(item => item.key)
+    },
+    handleOnlyAvailableChange(onlyAvailable) {
+      this.applyDefaultSelect(onlyAvailable)
+    },
+    async handleImport() {
+      if (!this.selected.length) return
+      this.disabled = true
+      this.btnText = this.$t('user_api_import_online__input_loading')
+      const base = (this.useProxy ? PROXY_BASE : RAW_BASE) + SOURCE_PATH
+      this.$emit('import-start')
+      this.handleClose()
+      let added = 0
+      let updated = 0
+      let skipped = 0
+      let reachLimit = false
+      let finalList = userApi.list
+      const fails = []
+      for (const key of this.selected) {
+        try {
+          const script = await this.fetchText(`${base}/${key}/latest.js`)
+          const { apiList, updated: isUpdate } = await importUserApi(script)
+          finalList = apiList
+          isUpdate ? updated++ : added++
+        } catch (err) {
+          const message = err.message || ''
+          // 后端按「作者+名字+version」去重：同版本跳过；同名同作者的新版本覆盖更新；达到 20 上限则停止
+          // shortcut: 靠后端中文错误文案判定类型（IPC 会丢弃自定义错误码），改文案需同步这里
+          if (message.includes('脚本内容与已有的源')) {
+            skipped++
+            continue
+          }
+          if (message.includes('最多只能同时存在 20 个源')) {
+            reachLimit = true
+            break
+          }
+          fails.push(`${key}: ${message}`)
+        }
+      }
+      userApi.list = finalList
+      this.$emit('import-done')
+      if (reachLimit) {
+        void dialog(this.$t('user_api__max_tip'))
+      } else if (fails.length) {
+        void dialog(this.$t('user_api_one_click__import_result', { ok: added + updated, fail: fails.length, detail: fails.join('\n') }))
+      } else if (updated || skipped) {
+        void dialog(this.$t('user_api_one_click__import_summary', { add: added, update: updated, skip: skipped }))
+      } else {
+        void dialog(this.$t('user_api_one_click__import_success', { ok: added }))
+      }
+      if (userApi.list.length) void this.autoProbeAndSelect()
+    },
+    async autoProbeAndSelect() {
+      let results
+      try {
+        results = await probeUserApis()
+        setProbeRanking(results)
+        const warmIds = results.filter(r => r.ok > 0).slice(0, 4).map(r => r.id)
+        if (warmIds.length) void warmProbeWindows(warmIds)
+      } catch (err) {
+        void dialog(this.$t('user_api_probe__failed', { message: err.message }))
+        return
+      }
+      const available = results.filter(r => r.ok > 0)
+      if (!available.length) {
+        // 全部探测失败，可能只是本机网络问题，此时不提供“清理失效源”，避免误删
+        void dialog(this.$t('user_api_probe__none'))
+        return
+      }
+      const best = available[0]
+      const current = appSetting['common.apiSource'] || ''
+      const cur = results.find(r => r.id === current)
+      // 仅当前源未设置，或当前用户源探测为失效(无一次成功)时才切换；内置源尊重用户选择
+      const currentInvalid = !current || (/^user_api/.test(current) && (!cur || cur.ok === 0))
+      const rate = Math.round(best.okRate * 100)
+      const ms = best.avgMs ?? best.bestMs ?? '-'
+      if (currentInvalid && best.id !== current) {
+        try {
+          await setUserApi(best.id)
+        } catch (err) {
+          console.log(err)
+        }
+        void dialog(this.$t('user_api_probe__done_switch', { name: best.name, rate, ms }))
+      } else {
+        void dialog(this.$t('user_api_probe__done_keep', { name: best.name, rate, ms }))
+      }
+      // 有可用源作参照（说明网络正常），再询问是否移除确认失效的已安装源
+      await this.confirmRemoveInvalid(results)
+    },
+    async confirmRemoveInvalid(results) {
+      const active = appSetting['common.apiSource'] || ''
+      // 失效 = 提取到上游主机但全部探测失败；跳过当前正在使用的源；hosts=0(无法判定)不处理
+      const invalid = results.filter(item => item.status === '失效' && item.hosts > 0 && item.id !== active)
+      if (!invalid.length) return
+      const isConfirm = await dialog.confirm(this.$t('user_api_one_click__remove_invalid_confirm', {
+        count: invalid.length,
+        names: invalid.map(item => item.name).join('、'),
+      }))
+      if (!isConfirm) return
+      try {
+        userApi.list = await removeUserApi(invalid.map(item => item.id))
+        void dialog(this.$t('user_api_one_click__remove_invalid_done', { count: invalid.length }))
+      } catch (err) {
+        console.log(err)
+      }
+    },
+  },
+}
+</script>
+
