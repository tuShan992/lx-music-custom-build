+<template>
+  <material-modal :show="show" teleport="#view" @close="handleClose">
+    <main :class="$style.main">
+      <h2>{{ $t('user_api_probe_modal__title') }}</h2>
+      <p :class="$style.tip">{{ $t('user_api_probe_modal__tip') }}</p>
+      <p v-if="realError" :class="$style.realNote">{{ realError }}</p>
+      <div :class="$style.content">
+        <div v-if="loading" :class="$style.empty">{{ $t('user_api_probe_modal__loading') }}</div>
+        <div v-else-if="error" :class="$style.empty">{{ error }}</div>
+        <div v-else-if="!list.length" :class="$style.empty">{{ $t('user_api_probe_modal__empty') }}</div>
+        <ul v-else :class="$style.list">
+          <li
+            v-for="(item, index) in list"
+            :key="item.id"
+            :class="[$style.item, { [$style.itemDisabled]: !isSelectable(item), [$style.itemActive]: selectedId === item.id }]"
+            @click="handleSelect(item)"
+          >
+            <div :class="$style.rowTop">
+              <span :class="$style.rank">{{ index + 1 }}</span>
+              <span :class="$style.name">{{ item.name }}</span>
+              <span :class="$style.check">{{ selectedId === item.id ? '●' : '' }}</span>
+            </div>
+            <div :class="$style.rowMeta">
+              <span>{{ $t('user_api_probe_modal__conn_label') }} <b :class="$style[statusCls(item.status)]">{{ item.status }}</b></span>
+              <span>{{ $t('user_api_probe_modal__hosts_label') }} {{ item.hosts }}</span>
+              <span>{{ $t('user_api_probe_modal__ok_rate_label') }} {{ pct(item.okRate) }}%</span>
+              <span>{{ $t('user_api_probe_modal__reach_rate_label') }} {{ pct(item.reachRate) }}%</span>
+              <span>{{ $t('user_api_probe_modal__avg_label') }} {{ item.avgMs != null ? `${item.avgMs}ms` : '—' }}</span>
+              <span>{{ $t('user_api_probe_modal__best_label') }} {{ item.bestMs != null ? `${item.bestMs}ms` : '—' }}</span>
+            </div>
+            <div :class="$style.rowReal">
+              <span :class="$style.realTag">{{ $t('user_api_probe_modal__real_label') }}</span>
+              <span v-if="item.realLive" :class="$style.realOk">{{ $t('user_api_probe_modal__real_live') }}</span>
+              <span v-else-if="realLoading && item.realOk == null" :class="$style.realTesting">{{ $t('user_api_probe_modal__real_testing') }}</span>
+              <span v-else-if="item.realOk === true" :class="$style.realOk">{{ $t('user_api_probe_modal__real_ok', { ms: item.realMs }) }}</span>
+              <span v-else-if="item.realOk === false" :class="$style.realBad">{{ $t('user_api_probe_modal__real_bad') }}</span>
+              <span v-else :class="$style.realTesting">—</span>
+            </div>
+          </li>
+        </ul>
+      </div>
+      <div :class="$style.footer">
+        <base-btn :class="$style.btn" @click="handleClose">{{ $t('btn_close') }}</base-btn>
+        <base-btn :class="$style.btn" :disabled="!selectedId" @click="handleConfirm">{{ $t('user_api_probe_modal__confirm') }}</base-btn>
+      </div>
+    </main>
+  </material-modal>
+</template>
+
+<script>
+import { probeUserApis, warmProbeWindows, probeSourcesReal } from '@renderer/utils/ipc'
+import { setProbeRanking } from '@renderer/core/userApiSourceCache'
+import { playMusicInfo, isPlay } from '@renderer/store/player/state'
+import { apiSource } from '@renderer/store'
+import { appSetting } from '@renderer/store/setting'
+import { getPlayQuality } from '@renderer/core/music/utils'
+
+const statusPriority = { 可用: 0, 异常: 1, 失效: 2 }
+
+export default {
+  props: {
+    show: {
+      type: Boolean,
+      default: false,
+    },
+  },
+  emits: ['update:show', 'select'],
+  data() {
+    return {
+      list: [],
+      selectedId: '',
+      loading: false,
+      error: '',
+      realLoading: false,
+      realError: '',
+    }
+  },
+  watch: {
+    show(value) {
+      if (value) void this.init()
+    },
+  },
+  methods: {
+    statusCls(status) {
+      return status === '可用' ? 'ok' : status === '异常' ? 'warn' : 'dead'
+    },
+    pct(rate) {
+      return Math.round((rate || 0) * 100)
+    },
+    isSelectable() {
+      // 测试结果只作参考：允许选择任意源（真实播放可能走了脚本内的其它平台/方式）
+      return true
+    },
+    async init() {
+      this.loading = true
+      this.error = ''
+      this.list = []
+      this.selectedId = ''
+      this.realLoading = false
+      this.realError = ''
+      try {
+        const results = await probeUserApis()
+        setProbeRanking(results)
+        const warmIds = results.filter(r => r.ok > 0).slice(0, 4).map(r => r.id)
+        if (warmIds.length) void warmProbeWindows(warmIds)
+        this.list = [...results].sort((a, b) => {
+          const an = a.avgMs == null ? 1 : 0
+          const bn = b.avgMs == null ? 1 : 0
+          if (an !== bn) return an - bn
+          if (an === 0) return a.avgMs - b.avgMs
+          return (statusPriority[a.status] ?? 3) - (statusPriority[b.status] ?? 3)
+        }).map(item => ({ ...item, realOk: null, realMs: null, realLive: false }))
+        const first = this.list.find(item => item.avgMs != null)
+        if (first) this.selectedId = first.id
+      } catch (err) {
+        this.error = this.$t('user_api_probe_modal__failed', { message: err.message })
+      } finally {
+        this.loading = false
+      }
+      void this.runRealTest()
+    },
+    async runRealTest() {
+      const song = playMusicInfo.musicInfo
+      if (!song || !('source' in song)) {
+        this.realError = this.$t('user_api_probe_modal__no_song')
+        return
+      }
+      const ids = this.list.map(item => item.id)
+      if (!ids.length) return
+      const activeId = apiSource.value
+      // 当前源若正在实际播放这首歌，直接以“实播为准”判为可播
+      const playingActive = !!isPlay.value && !!playMusicInfo.musicInfo
+      this.realLoading = true
+      try {
+        // 与播放一致：先试该歌的“其它平台版本”(toggleMusicInfo)，再试原曲
+        const candidates = []
+        const toggle = song.meta?.toggleMusicInfo
+        if (toggle) candidates.push(toggle)
+        candidates.push(song)
+        const requests = candidates.map(mi => ({
+          source: mi.source,
+          action: 'musicUrl',
+          info: { type: getPlayQuality(appSetting['player.playQuality'], mi), musicInfo: mi },
+        }))
+        const results = await probeSourcesReal(ids, requests)
+        const map = new Map(results.map(r => [r.apiId, r]))
+        this.list = this.list.map(item => {
+          if (item.id === activeId && playingActive) {
+            return { ...item, realOk: true, realMs: null, realLive: true }
+          }
+          const r = map.get(item.id)
+          return { ...item, realOk: r ? r.ok : false, realMs: r ? r.ms : null, realLive: false }
+        })
+        // 有真实可播放的源时，默认选中第一个可播放的
+        const bestReal = this.list.find(item => item.realOk === true)
+        if (bestReal) this.selectedId = bestReal.id
+      } catch (err) {
+        this.realError = this.$t('user_api_probe_modal__real_failed', { message: err.message })
+      } finally {
+        this.realLoading = false
+      }
+    },
+    handleSelect(item) {
+      if (!this.isSelectable(item)) return
+      this.selectedId = item.id
+    },
+    handleConfirm() {
+      if (!this.selectedId) return
+      this.$emit('select', this.selectedId)
+      this.handleClose()
+    },
+    handleClose() {
+      this.$emit('update:show', false)
+    },
+  },
+}
+</script>
+
