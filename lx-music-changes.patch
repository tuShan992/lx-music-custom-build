diff --git a/src/main/modules/userApi/parallel.ts b/src/main/modules/userApi/parallel.ts
new file mode 100644
index 0000000..2fc86ca
--- /dev/null
+++ b/src/main/modules/userApi/parallel.ts
@@ -0,0 +1,205 @@
+import http from 'node:http'
+import https from 'node:https'
+
+import { createProbeWindow, destroyProbeWindow } from './main'
+import { requestOnWindow, waitProbeReady } from './rendererEvent/rendererEvent'
+import { getUserApis } from './utils'
+
+const URL_CHECK_TIMEOUT = 4000
+const REQUEST_TIMEOUT = 5000
+const READY_TIMEOUT = 6000
+const MASTER_EXTRA = 1500
+const MAX_PARALLEL = 10
+
+// 探测窗口池：复用已加载好的源窗口，避免每次失败都重建窗口（1~3s）
+const POOL_MAX = MAX_PARALLEL
+const POOL_IDLE = 60_000
+interface PoolEntry { win: Electron.BrowserWindow, lastUsed: number }
+const probePool = new Map<string, PoolEntry>()
+let running = false
+
+const evictIdle = () => {
+  const now = Date.now()
+  for (const [id, entry] of probePool) {
+    if (entry.win.isDestroyed() || now - entry.lastUsed > POOL_IDLE) {
+      probePool.delete(id)
+      if (!entry.win.isDestroyed()) void destroyProbeWindow(entry.win)
+    }
+  }
+}
+const evictLruIfFull = () => {
+  if (probePool.size < POOL_MAX) return
+  let lruId: string | null = null
+  let lruTime = Infinity
+  for (const [id, entry] of probePool) {
+    if (entry.lastUsed < lruTime) { lruTime = entry.lastUsed; lruId = id }
+  }
+  if (lruId) {
+    const entry = probePool.get(lruId)!
+    probePool.delete(lruId)
+    if (!entry.win.isDestroyed()) void destroyProbeWindow(entry.win)
+  }
+}
+// 取（复用或新建）一个已就绪的探测窗口。返回 null 表示该源不可用
+const acquireWindow = async(apiInfo: LX.UserApi.UserApiInfo): Promise<Electron.BrowserWindow | null> => {
+  evictIdle()
+  const cached = probePool.get(apiInfo.id)
+  if (cached && !cached.win.isDestroyed()) {
+    cached.lastUsed = Date.now()
+    return cached.win
+  }
+  evictLruIfFull()
+  const readyPromise = waitProbeReady(apiInfo.id, READY_TIMEOUT)
+  const win = await createProbeWindow(apiInfo)
+  const ready = await readyPromise
+  if (!ready) {
+    void destroyProbeWindow(win)
+    return null
+  }
+  // 并发可能重复创建同源窗口：以池中已有的为准，销毁多出来的
+  const existed = probePool.get(apiInfo.id)
+  if (existed && !existed.win.isDestroyed()) {
+    void destroyProbeWindow(win)
+    existed.lastUsed = Date.now()
+    return existed.win
+  }
+  const entry: PoolEntry = { win, lastUsed: Date.now() }
+  probePool.set(apiInfo.id, entry)
+  win.on('closed', () => {
+    if (probePool.get(apiInfo.id)?.win === win) probePool.delete(apiInfo.id)
+  })
+  return win
+}
+
+const checkUrlAlive = async(url: string): Promise<boolean> => await new Promise(resolve => {
+  let settled = false
+  const done = (ok: boolean) => {
+    if (settled) return
+    settled = true
+    clearTimeout(timer)
+    resolve(ok)
+  }
+  const timer = setTimeout(() => { done(false) }, URL_CHECK_TIMEOUT)
+  try {
+    const u = new URL(url)
+    const getter = (u.protocol === 'http:' ? http.get : https.get) as typeof http.get
+    const req = getter(url, { headers: { 'User-Agent': 'lx-music-probe/1.0', Range: 'bytes=0-1' } }, res => {
+      const code = res.statusCode ?? 0
+      res.destroy()
+      done(code >= 200 && code < 400)
+    })
+    req.on('error', () => { done(false) })
+    req.setTimeout(URL_CHECK_TIMEOUT, () => { req.destroy(); done(false) })
+  } catch {
+    done(false)
+  }
+})
+
+export interface ParallelTryResult {
+  apiId: string
+  url: string
+}
+
+// 并行在前 maxParallel 个候选源里尝试取该歌播放链接，返回第一个“可取到且 URL 存活”的源
+export const tryApisForMusicUrl = async(apiIds: string[], data: any, maxParallel = MAX_PARALLEL): Promise<ParallelTryResult | null> => {
+  if (running) return null
+  const apiById = new Map(getUserApis().map(api => [api.id, api]))
+  const ids = apiIds.filter(id => apiById.has(id)).slice(0, maxParallel)
+  if (!ids.length) return null
+
+  running = true
+  try {
+    return await new Promise<ParallelTryResult | null>(resolve => {
+      let settled = false
+      let remaining = ids.length
+      let masterTimer: NodeJS.Timeout | null = null
+      const finish = (val: ParallelTryResult | null) => {
+        if (settled) return
+        settled = true
+        if (masterTimer) clearTimeout(masterTimer)
+        resolve(val)
+      }
+      masterTimer = setTimeout(() => { finish(null) }, READY_TIMEOUT + REQUEST_TIMEOUT + MASTER_EXTRA)
+      for (const id of ids) {
+        void (async() => {
+          try {
+            const win = await acquireWindow(apiById.get(id)!)
+            if (!win) return
+            const res = await requestOnWindow(win, data, REQUEST_TIMEOUT)
+            const url = res?.data?.url
+            if (typeof url === 'string' && /^https?:/.test(url) && await checkUrlAlive(url)) finish({ apiId: id, url })
+          } catch {
+            // 单个源失败不影响其它并行源
+          } finally {
+            remaining--
+            if (remaining === 0) finish(null)
+          }
+        })()
+      }
+    })
+  } finally {
+    // eslint-disable-next-line require-atomic-updates
+    running = false
+  }
+}
+
+// 预热：把前 max 个候选源窗口提前加载进池，使首次换源无需再建窗（后台、可失败）
+export const warmProbeWindows = async(apiIds: string[], max = 4): Promise<void> => {
+  const apiById = new Map(getUserApis().map(api => [api.id, api]))
+  const ids = apiIds.filter(id => apiById.has(id)).slice(0, max)
+  for (const id of ids) {
+    const cached = probePool.get(id)
+    if (cached && !cached.win.isDestroyed()) continue
+    try {
+      await acquireWindow(apiById.get(id)!)
+    } catch {
+      // 预热失败忽略
+    }
+  }
+}
+
+export interface RealProbeResult {
+  apiId: string
+  ok: boolean
+  ms: number | null
+}
+
+const mapLimit = async<T, R>(items: T[], limit: number, fn: (item: T) => Promise<R>): Promise<R[]> => {
+  const results: R[] = new Array(items.length)
+  let index = 0
+  const worker = async() => {
+    while (index < items.length) {
+      const current = index++
+      results[current] = await fn(items[current])
+    }
+  }
+  await Promise.all(Array.from({ length: Math.min(limit, items.length) }, worker))
+  return results
+}
+
+// 真实可用性测试：对每个源依次尝试多个候选（如 toggleMusicInfo、原曲），取到存活链接即可播
+export const probeSourcesReal = async(apiIds: string[], requests: any[], concurrency = 3, timeoutMs = 8000): Promise<RealProbeResult[]> => {
+  const apiById = new Map(getUserApis().map(api => [api.id, api]))
+  const ids = apiIds.filter(id => apiById.has(id))
+  return await mapLimit(ids, concurrency, async id => {
+    try {
+      const win = await acquireWindow(apiById.get(id)!)
+      if (!win) return { apiId: id, ok: false, ms: null }
+      const start = Date.now()
+      for (const req of requests) {
+        try {
+          const res = await requestOnWindow(win, req, timeoutMs)
+          const url = res?.data?.url
+          if (typeof url === 'string' && /^https?:/.test(url) && await checkUrlAlive(url)) {
+            return { apiId: id, ok: true, ms: Date.now() - start }
+          }
+        } catch {
+          // 该候选失败，试下一个
+        }
+      }
+      return { apiId: id, ok: false, ms: null }
+    } catch {
+      return { apiId: id, ok: false, ms: null }
+    }
+  })
+}
diff --git a/src/main/modules/userApi/probe.ts b/src/main/modules/userApi/probe.ts
new file mode 100644
index 0000000..dd3fa08
--- /dev/null
+++ b/src/main/modules/userApi/probe.ts
@@ -0,0 +1,218 @@
+import http from 'node:http'
+import https from 'node:https'
+
+import { getScript, getUserApis } from './utils'
+
+// 多轮探测：对每个上游主机发起 PROBE_ROUNDS 次 GET，按成功(2xx)/异常(有响应非2xx)/失败(不可达)
+// 统计成功率与延迟。只探测上游主机可达性，不执行音源脚本，口径与源仓库 health-check 一致。
+const PROBE_TIMEOUT = 6000
+const PROBE_ROUNDS = 3
+const PROBE_CONCURRENCY = 20
+const MAX_REDIRECTS = 2
+const USER_AGENT = 'lx-music-desktop-stability-probe/1.0'
+
+// 主机提取正则（移植自源仓库 probe.py）
+const RE_HOST = /https?:\/\/((?:[A-Za-z0-9-]+\.)+(?:xn--[A-Za-z0-9-]+|[A-Za-z]{2,}))/g
+const RE_IPV4 = /https?:\/\/((?:\d{1,3}\.){3}\d{1,3})/g
+const RE_IPV4_LITERAL = /^(?:\d{1,3}\.){3}\d{1,3}$/
+const RE_HEX_RUN = /(?:\\x[0-9a-fA-F]{2}){4,}/g
+const RE_HEX_BYTE = /\\x([0-9a-fA-F]{2})/g
+const RE_SCHEME_HEAD = /^https?:\/\//
+const RE_ADDR_TAIL = /^[\d.]+\/?$/
+const RE_SERVER_CONFIG = /SERVER_SCRIPT_CONFIG'?\]?\s*=\s*(\{[^{}]*\})/g
+const DOMAIN_BLOCKLIST = new Set(['www.w3.org', 'gistry.npm'])
+const MAX_URL_PARTS = 3
+const MAX_TAIL_CANDIDATES = 32
+const MAX_URL_LEN = 256
+
+const matchAllHosts = (text: string, re: RegExp): string[] => {
+  const out: string[] = []
+  for (const m of text.matchAll(re)) out.push(m[1].toLowerCase())
+  return out
+}
+
+const decodeHexFragments = (text: string): string[] => {
+  const out: string[] = []
+  for (const run of text.matchAll(RE_HEX_RUN)) {
+    const bytes: number[] = []
+    for (const h of run[0].matchAll(RE_HEX_BYTE)) bytes.push(parseInt(h[1], 16))
+    out.push(Buffer.from(bytes).toString('latin1'))
+  }
+  return out
+}
+
+// 把被混淆阵列切碎的 IPv4 地址拼回完整主机名（首段带 scheme，续段是纯数字/点）
+const joinedIpv4Hosts = (fragments: string[]): string[] => {
+  const heads = fragments.filter(f => RE_SCHEME_HEAD.test(f))
+  const tails = fragments.filter(f => RE_ADDR_TAIL.test(f)).slice(0, MAX_TAIL_CANDIDATES)
+  const combos: string[][] = tails.map(t => [t])
+  if (MAX_URL_PARTS >= 3) {
+    for (const first of tails) {
+      for (const second of tails) {
+        if (first !== second) combos.push([first, second])
+      }
+    }
+  }
+  const hosts = new Set<string>()
+  for (const head of heads) {
+    for (const parts of combos) {
+      const url = head + parts.join('')
+      if (url.length > MAX_URL_LEN) continue
+      let hostname: string
+      try {
+        hostname = new URL(url).hostname
+      } catch {
+        continue
+      }
+      if (hostname && RE_IPV4_LITERAL.test(hostname)) hosts.add(hostname.toLowerCase())
+    }
+  }
+  return [...hosts]
+}
+
+export const extractHosts = (text: string): string[] => {
+  const hosts = new Set<string>()
+  matchAllHosts(text, RE_HOST).forEach(h => hosts.add(h))
+  matchAllHosts(text, RE_IPV4).forEach(h => hosts.add(h))
+
+  const fragments = decodeHexFragments(text)
+  for (const decoded of fragments) {
+    matchAllHosts(decoded, RE_HOST).forEach(h => hosts.add(h))
+    matchAllHosts(decoded, RE_IPV4).forEach(h => hosts.add(h))
+  }
+  joinedIpv4Hosts(fragments).forEach(h => hosts.add(h))
+
+  for (const cfg of text.matchAll(RE_SERVER_CONFIG)) {
+    try {
+      const config = JSON.parse(cfg[1])
+      const apiUrl: string | undefined = config.apiUrl || config.api_url
+      if (apiUrl) {
+        const hostname = new URL(apiUrl).hostname
+        if (hostname) hosts.add(hostname.toLowerCase())
+      }
+    } catch {
+      // 配置块不是合法 JSON，忽略
+    }
+  }
+
+  return [...hosts].filter(h => !DOMAIN_BLOCKLIST.has(h)).sort()
+}
+
+interface ProbeAttempt {
+  raw: 'ok' | 'warn' | 'failed'
+  ms: number
+}
+
+const probeHost = async(host: string): Promise<ProbeAttempt> => {
+  const scheme = RE_IPV4_LITERAL.test(host) ? 'http' : 'https'
+  const start = Date.now()
+
+  return new Promise(resolve => {
+    let settled = false
+    const done = (raw: ProbeAttempt['raw']) => {
+      if (settled) return
+      settled = true
+      clearTimeout(timer)
+      resolve({ raw, ms: Date.now() - start })
+    }
+    const timer = setTimeout(() => { done('failed') }, PROBE_TIMEOUT)
+
+    const attempt = (url: string, redirectsLeft: number) => {
+      if (settled) return
+      let req: http.ClientRequest
+      try {
+        const protocol = new URL(url).protocol
+        const getter = (protocol === 'http:' ? http.get : https.get) as typeof http.get
+        req = getter(url, { headers: { 'User-Agent': USER_AGENT } }, res => {
+          const code = res.statusCode ?? 0
+          if (code >= 300 && code < 400 && res.headers.location && redirectsLeft > 0) {
+            res.resume()
+            try {
+              attempt(new URL(res.headers.location, url).toString(), redirectsLeft - 1)
+            } catch {
+              done('warn')
+            }
+            return
+          }
+          res.resume()
+          done(code >= 200 && code < 300 ? 'ok' : 'warn')
+        })
+      } catch {
+        done('failed')
+        return
+      }
+      req.on('error', () => { done('failed') })
+    }
+
+    attempt(`${scheme}://${host}/`, MAX_REDIRECTS)
+  })
+}
+
+const mapLimit = async<T, R>(items: T[], limit: number, fn: (item: T) => Promise<R>): Promise<R[]> => {
+  const results: R[] = new Array(items.length)
+  let index = 0
+  const worker = async() => {
+    while (index < items.length) {
+      const current = index++
+      results[current] = await fn(items[current])
+    }
+  }
+  await Promise.all(Array.from({ length: Math.min(limit, items.length) }, worker))
+  return results
+}
+
+const probeHostRounds = async(host: string): Promise<ProbeAttempt[]> => {
+  const attempts: ProbeAttempt[] = []
+  for (let i = 0; i < PROBE_ROUNDS; i++) attempts.push(await probeHost(host))
+  return attempts
+}
+
+export const probeUserApis = async(): Promise<LX.UserApi.UserApiProbeResult[]> => {
+  const apis = getUserApis()
+  if (!apis.length) return []
+
+  const sourceHosts = await Promise.all(apis.map(async api => ({
+    api,
+    hosts: extractHosts(await getScript(api.id)),
+  })))
+
+  const allHosts = [...new Set(sourceHosts.flatMap(item => item.hosts))]
+  const probed = await mapLimit(allHosts, PROBE_CONCURRENCY, async host => ({ host, attempts: await probeHostRounds(host) }))
+  const attemptMap = new Map(probed.map(item => [item.host, item.attempts]))
+
+  const results: LX.UserApi.UserApiProbeResult[] = sourceHosts.map(({ api, hosts }) => {
+    let ok = 0
+    let warn = 0
+    let fail = 0
+    const okLatencies: number[] = []
+    for (const host of hosts) {
+      for (const attempt of attemptMap.get(host) ?? []) {
+        if (attempt.raw === 'ok') {
+          ok++
+          okLatencies.push(attempt.ms)
+        } else if (attempt.raw === 'warn') warn++
+        else fail++
+      }
+    }
+    const total = ok + warn + fail
+    return {
+      id: api.id,
+      name: api.name,
+      hosts: hosts.length,
+      ok,
+      warn,
+      fail,
+      okRate: total ? ok / total : 0,
+      reachRate: total ? (ok + warn) / total : 0,
+      avgMs: okLatencies.length ? Math.round(okLatencies.reduce((s, n) => s + n, 0) / okLatencies.length) : null,
+      bestMs: okLatencies.length ? Math.min(...okLatencies) : null,
+      status: ok > 0 ? '可用' : warn > 0 ? '异常' : '失效',
+    }
+  })
+
+  const statusPriority = { 可用: 0, 异常: 1, 失效: 2 } as const
+  results.sort((a, b) => statusPriority[a.status] - statusPriority[b.status] ||
+    b.okRate - a.okRate ||
+    ((a.avgMs ?? Number.MAX_SAFE_INTEGER) - (b.avgMs ?? Number.MAX_SAFE_INTEGER)))
+  return results
+}
