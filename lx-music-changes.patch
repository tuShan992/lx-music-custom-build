diff --git a/src/renderer/views/Setting/components/UserApiOneClickImportModal.vue b/src/renderer/views/Setting/components/UserApiOneClickImportModal.vue
new file mode 100644
index 0000000..85746e8
--- /dev/null
+++ b/src/renderer/views/Setting/components/UserApiOneClickImportModal.vue
@@ -0,0 +1,269 @@
+<template>
+  <material-modal :show="show" teleport="#view" @close="handleClose">
+    <main :class="$style.main">
+      <h2>{{ $t('user_api_one_click__title') }}</h2>
+      <div :class="$style.options">
+        <base-checkbox
+          id="user_api_one_click_only_available"
+          v-model="onlyAvailable"
+          :class="$style.option"
+          :label="$t('user_api_one_click__only_available')"
+          @change="handleOnlyAvailableChange"
+        />
+        <base-checkbox
+          id="user_api_one_click_use_proxy"
+          v-model="useProxy"
+          :class="$style.option"
+          :label="$t('user_api_one_click__use_proxy')"
+        />
+      </div>
+      <p :class="$style.tip">{{ $t('user_api_one_click__tip', { time: updatedAt || '-' }) }}</p>
+      <div :class="$style.content">
+        <div v-if="loading" :class="$style.empty">{{ $t('user_api_one_click__loading') }}</div>
+        <div v-else-if="loadError" :class="$style.empty">{{ loadError }}</div>
+        <div v-else-if="!list.length" :class="$style.empty">{{ $t('user_api__noitem') }}</div>
+        <ul v-else :class="$style.list">
+          <li v-for="item in list" :key="item.key" :class="$style.item">
+            <base-checkbox
+              :id="`user_api_one_click_${item.key}`"
+              v-model="selected"
+              :value="item.key"
+              :class="$style.itemCheckbox"
+              :label="item.key"
+            />
+            <span :class="[$style.status, $style[item.cls]]">{{ item.status }}</span>
+          </li>
+        </ul>
+      </div>
+      <div :class="$style.footer">
+        <base-btn :class="$style.btn" @click="handleClose">{{ $t('btn_close') }}</base-btn>
+        <base-btn :class="$style.btn" :disabled="disabled || loading || !!loadError || !selected.length" @click="handleImport">{{ btnText }}</base-btn>
+      </div>
+    </main>
+  </material-modal>
+</template>
+
+<script>
+import { dialog } from '@renderer/plugins/Dialog'
+import { httpFetch } from '@renderer/utils/request'
+import { importUserApi } from '@renderer/utils/ipc'
+import { userApi } from '@renderer/store'
+
+const RAW_BASE = 'https://raw.githubusercontent.com/pdone/lx-music-source'
+const PROXY_BASE = 'https://ghproxy.net/raw.githubusercontent.com/pdone/lx-music-source'
+const HEALTH_PATH = '/health-status/health-state.json'
+const SOURCE_PATH = '/main'
+
+const statusClass = (status) => {
+  switch (status) {
+    case '可用': return 'available'
+    case '异常': return 'warn'
+    default: return 'invalid'
+  }
+}
+
+export default {
+  props: {
+    show: {
+      type: Boolean,
+      default: false,
+    },
+  },
+  emits: ['update:show', 'import-start', 'import-done'],
+  data() {
+    return {
+      onlyAvailable: true,
+      useProxy: false,
+      list: [],
+      selected: [],
+      updatedAt: '',
+      loading: false,
+      loadError: '',
+      disabled: false,
+      btnText: '',
+    }
+  },
+  watch: {
+    show(n) {
+      if (n) void this.init()
+    },
+  },
+  methods: {
+    handleClose() {
+      this.$emit('update:show', false)
+    },
+    fetchText(url) {
+      return httpFetch(url, { timeout: 20_000 }).promise.then(resp => resp.body)
+    },
+    async fetchHealth() {
+      let lastErr
+      for (const base of [RAW_BASE, PROXY_BASE]) {
+        try {
+          const body = await this.fetchText(base + HEALTH_PATH)
+          return typeof body === 'string' ? JSON.parse(body) : body
+        } catch (err) {
+          lastErr = err
+        }
+      }
+      throw lastErr
+    },
+    async init() {
+      this.loading = true
+      this.loadError = ''
+      this.list = []
+      this.selected = []
+      this.updatedAt = ''
+      this.onlyAvailable = true
+      this.useProxy = false
+      this.disabled = false
+      this.btnText = this.$t('user_api_one_click__import')
+      try {
+        const data = await this.fetchHealth()
+        this.list = Object.entries(data.sources || {}).map(([key, status]) => ({ key, status, cls: statusClass(status) }))
+        this.updatedAt = data.updated_at || ''
+        this.applyDefaultSelect()
+      } catch (err) {
+        this.loadError = this.$t('user_api_one_click__load_failed', { message: err.message })
+      } finally {
+        this.loading = false
+      }
+    },
+    applyDefaultSelect(onlyAvailable = this.onlyAvailable) {
+      this.selected = this.list
+        .filter(item => !onlyAvailable || item.status === '可用')
+        .map(item => item.key)
+    },
+    handleOnlyAvailableChange(onlyAvailable) {
+      this.applyDefaultSelect(onlyAvailable)
+    },
+    async handleImport() {
+      if (!this.selected.length) return
+      if (userApi.list.length + this.selected.length > 20) {
+        void dialog(this.$t('user_api__max_tip'))
+        return
+      }
+      this.disabled = true
+      this.btnText = this.$t('user_api_import_online__input_loading')
+      const base = (this.useProxy ? PROXY_BASE : RAW_BASE) + SOURCE_PATH
+      this.$emit('import-start')
+      this.handleClose()
+      let ok = 0
+      let finalList
+      const fails = []
+      for (const key of this.selected) {
+        try {
+          const script = await this.fetchText(`${base}/${key}/latest.js`)
+          const { apiList } = await importUserApi(script)
+          finalList = apiList
+          ok++
+        } catch (err) {
+          fails.push(`${key}: ${err.message}`)
+        }
+      }
+      if (finalList) userApi.list = finalList
+      this.$emit('import-done')
+      if (fails.length) {
+        void dialog(this.$t('user_api_one_click__import_result', { ok, fail: fails.length, detail: fails.join('\n') }))
+      } else {
+        void dialog(this.$t('user_api_one_click__import_success', { ok }))
+      }
+    },
+  },
+}
+</script>
+
+<style lang="less" module>
+@import '@renderer/assets/styles/layout.less';
+
+.main {
+  padding: 0 15px;
+  width: 450px;
+  min-width: 280px;
+  display: flex;
+  flex-flow: column nowrap;
+  min-height: 0;
+  max-height: 80vh;
+  h2 {
+    font-size: 16px;
+    color: var(--color-font);
+    line-height: 1.3;
+    text-align: center;
+    padding: 15px 0 10px;
+  }
+}
+.options {
+  display: flex;
+  flex-flow: column nowrap;
+}
+.option {
+  font-size: 14px;
+  opacity: .9;
+  + .option {
+    margin-top: 8px;
+  }
+}
+.tip {
+  margin-top: 10px;
+  font-size: 12px;
+  line-height: 1.4;
+  color: var(--color-font-label);
+  white-space: pre-line;
+}
+.content {
+  flex: auto;
+  min-height: 80px;
+  margin-top: 10px;
+  overflow-y: auto;
+}
+.empty {
+  height: 100px;
+  font-size: 14px;
+  color: var(--color-font-label);
+  display: flex;
+  justify-content: center;
+  align-items: center;
+  text-align: center;
+  white-space: pre-line;
+  padding: 0 10px;
+}
+.list {
+  padding: 0 2px;
+}
+.item {
+  display: flex;
+  flex-flow: row nowrap;
+  align-items: center;
+  justify-content: space-between;
+  padding: 8px 6px;
+  border-radius: @radius-border;
+  &:hover {
+    background-color: var(--color-primary-background-hover);
+  }
+}
+.itemCheckbox {
+  font-size: 14px;
+}
+.status {
+  flex: none;
+  font-size: 12px;
+  margin-left: 10px;
+  &.available {
+    color: var(--color-primary);
+  }
+  &.warn {
+    color: #e6a23c;
+  }
+  &.invalid {
+    color: #f56c6c;
+  }
+}
+.footer {
+  margin: 15px 0 15px auto;
+}
+.btn {
+  min-width: 70px;
+  + .btn {
+    margin-left: 10px;
+  }
+}
+</style>
